# 后端环境变量示例（本地开发推荐 PostgreSQL + Redis）
PROJECT_NAME=灵壤·铜仁苗绣蜡染非遗数字化平台
VERSION=1.0.0

DATABASE_URL=postgresql://postgres:522401@localhost:5432/miaoxiu
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

SD_API_URL=http://localhost:7860
SD_ENABLED=false

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE=10485760

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost","http://localhost:80"]
