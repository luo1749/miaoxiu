# 铜仁苗绣蜡染非遗数字化平台 环境变量示例
# 复制本文件为 .env 后按需修改

# 数据库（Docker Compose 中使用 PostgreSQL；本地开发也可使用 sqlite:///./miaoxiu.db）
DATABASE_URL=postgresql://postgres:522401@localhost:5432/miaoxiu
# Redis
REDIS_URL=redis://localhost:6379/0

# JWT 安全密钥（生产环境请使用强随机字符串）
SECRET_KEY=change-me-in-production-please-use-strong-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Stable Diffusion WebUI API
SD_API_URL=http://localhost:7860
SD_ENABLED=false

# Kimi / Moonshot API（用于多模态文化解析，可选）
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# 文件上传
UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE=10485760

# 前端跨域地址
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
